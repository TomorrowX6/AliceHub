function(alicehub_switch_artwork target romfs)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(android "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../project/app/src/main")
  set(kotlin "${android}/java/io/github/kichikuou/xsystem4")
  set(script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/generate_artwork.py")
  file(GLOB artwork CONFIGURE_DEPENDS "${android}/res/drawable-nodpi/ic_game_*.png")
  file(GLOB strings CONFIGURE_DEPENDS "${android}/res/values*/strings.xml")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${script}" "${kotlin}/GameCatalog.kt" "${kotlin}/OnlineInstaller.kt" ${artwork} ${strings})
  file(REMOVE_RECURSE "${romfs}/artwork")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${script}" "${android}"
    "${CMAKE_CURRENT_BINARY_DIR}" "${romfs}" RESULT_VARIABLE result)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Could not package Switch artwork (Python Pillow is required)")
  endif()
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  target_compile_definitions(${target} PRIVATE ALICEHUB_BUNDLED_ARTWORK)
  set(artwork_assets "")
  foreach(source IN LISTS artwork)
    get_filename_component(name "${source}" NAME_WE)
    string(REGEX REPLACE "^ic_game_" "" name "${name}")
    list(APPEND artwork_assets "artwork/${name}.jpg")
  endforeach()
  set(alicehub_artwork_assets "${artwork_assets}" PARENT_SCOPE)
  set(alicehub_nro_icon "${CMAKE_CURRENT_BINARY_DIR}/alicehub-icon.jpg" PARENT_SCOPE)
endfunction()

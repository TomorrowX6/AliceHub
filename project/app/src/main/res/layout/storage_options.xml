<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/storage_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/storage_option_public"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/public_storage_option" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/public_storage_benefits"
            android:textColor="@color/ui_text_secondary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/storage_option_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/private_storage_option" />
    </RadioGroup>

    <Button
        android:id="@+id/storage_help"
        style="@style/Widget.Launcher.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="@string/public_storage_why" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/active_install_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_screen_padding_h"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/ui_screen_padding_h"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_banner"
        android:drawableStart="@drawable/ic_download"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:drawablePadding="10dp"
        android:drawableTint="@color/tone_info_fg"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:text="@string/active_install_banner_text"
        android:textColor="@color/tone_info_fg"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/ui_card_gap"
        android:listSelector="@android:color/transparent"
        android:paddingStart="@dimen/ui_screen_padding_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ui_screen_padding_h"
        android:paddingBottom="16dp"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>

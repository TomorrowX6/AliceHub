<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/ui_screen_padding_h"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/settings_general_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:divider="@drawable/divider_line"
            android:dividerPadding="16dp"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:id="@+id/row_settings_online_install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_online"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_online_install"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switch_online_install"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_updates"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_check_for_updates"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switch_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_download_concurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_download_concurrency"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:text="@string/settings_download_concurrency"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_download_concurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chevron_settings_download_concurrency"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_theme"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_theme"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chevron_settings_theme"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_language"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_language"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chevron_settings_language"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_game_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_game_sort"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/settings_game_sort"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_game_sort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_gamepad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_gamepad"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_gamepad"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_gamepad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chevron_settings_gamepad"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_settings_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_settings_clear_cache"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_clear_cache"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/value_settings_clear_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chevron_settings_clear_cache"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ui_text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_about_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_card_gap"
            android:background="@drawable/bg_card"
            android:divider="@drawable/divider_line"
            android:dividerPadding="16dp"
            android:orientation="vertical"
            android:showDividers="middle">

            <Button
                android:id="@+id/btn_settings_qq_group"
                style="@style/Widget.Launcher.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_qq_group" />

            <Button
                android:id="@+id/btn_settings_licenses"
                style="@style/Widget.Launcher.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_licenses" />

            <Button
                android:id="@+id/btn_settings_github"
                style="@style/Widget.Launcher.ActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_github" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
